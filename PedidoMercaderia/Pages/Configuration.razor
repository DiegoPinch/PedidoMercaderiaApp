
@page "/configuracion"

@using PedidoMercaderia.Services
@inject ConfiguracionService Configuracion

<PageTitle>Configuración de bodegas</PageTitle>

<div class="container-fluid py-4">

    <h2 class="fw-bold mb-2">
        Configuración de bodegas
    </h2>

    <p class="text-muted mb-4">
        Define los centros desde donde tu sucursal
        puede solicitar mercadería.
    </p>

    <div class="alert alert-info">
        Puedes pedir a B1 (Matriz) y B40 (Ebenezer).
        B39 (Bame) es solo una referencia: no se usa para sugerir productos ni para abastecer B4.
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Cargando configuración...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="alert alert-danger">
            @errorCarga
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(esError ? "alert-danger" : "alert-success")">
                @mensaje
            </div>
        }

        <div class="row g-4">

            <div class="col-lg-5">

                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5 class="fw-bold mb-3">
                            Mi sucursal
                        </h5>

                        <label class="form-label">
                            Bodega asignada
                        </label>

                        <input class="form-control"
                               value="@Configuracion.ObtenerEtiquetaBodega("B4")"
                               readonly />

                        <p class="text-muted small mt-3">
                            El sistema analizará las existencias
                            de la sucursal B4 frente al
                            inventario nacional.
                        </p>

                    </div>
                </div>

            </div>

            <div class="col-lg-7">

                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5 class="fw-bold mb-3">
                            Centros de distribución
                        </h5>

                        @foreach (var bodega in
                            Configuracion.CentrosDistribucion)
                        {
                            <div class="form-check border rounded p-3 ps-5 mb-3"
                                 @key="bodega">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="@($"origen-{bodega}")"
                                       checked="@Configuracion.Actual.BodegasOrigen.Contains(bodega)"
                                       @onchange="e => CambiarOrigen(bodega, e)" />

                                <label class="form-check-label"
                                       for="@($"origen-{bodega}")">

                                    <strong>
                                        @Configuracion.ObtenerEtiquetaBodega(bodega)
                                    </strong>

                                </label>

                            </div>
                        }

                    </div>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-body">

                <h5 class="fw-bold mb-3">
                    Resumen
                </h5>

                <p>
                    <strong>Sucursal:</strong>
                    B4
                </p>

                <p>
                    <strong>Centros seleccionados:</strong>
                    @Configuracion.Actual.BodegasOrigen.Count
                </p>

                <p>
                    <strong>Productos marcados como No sugerir:</strong>
                    @Configuracion.Actual.ProductosNoSugerir.Count
                </p>

                <p class="text-muted">
                    Los filtros de stock nacional, participación
                    de B4 y disponibilidad se gestionan
                    directamente desde Preparar pedido.
                </p>

                <div class="d-flex gap-2 flex-wrap">

                    <button class="btn btn-primary"
                            disabled="@guardando"
                            @onclick="Guardar">
                        @(guardando
                            ? "Guardando..."
                            : "Guardar configuración")
                    </button>

                    <a href="pedido"
                       class="btn btn-outline-secondary">
                        Preparar pedido
                    </a>

                </div>

            </div>
        </div>
    }

</div>

@code {
    private bool cargando = true;
    private bool guardando;
    private bool esError;

    private string? mensaje;
    private string? errorCarga;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Configuracion.CargarAsync();
        }
        catch (Exception ex)
        {
            errorCarga = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarOrigen(
        string bodega,
        ChangeEventArgs e)
    {
        bool marcado = e.Value is bool valor && valor;

        if (marcado)
            Configuracion.Actual.BodegasOrigen.Add(bodega);
        else
            Configuracion.Actual.BodegasOrigen.Remove(bodega);

        mensaje = null;
    }

    private async Task Guardar()
    {
        mensaje = null;

        string? error = Configuracion.Validar();

        if (error is not null)
        {
            esError = true;
            mensaje = error;
            return;
        }

        guardando = true;

        try
        {
            await Configuracion.GuardarAsync();

            esError = false;
            mensaje = "Configuración guardada correctamente.";
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}
