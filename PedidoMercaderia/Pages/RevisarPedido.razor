@page "/pedido"
@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@using PedidoMercaderia.Models
@using PedidoMercaderia.Services
@using PedidoMercaderia.Components
@inject InventarioService Inventario
@inject ConfiguracionService Configuracion
@inject PedidoService Pedido
@inject ActividadService Actividad
@inject IJSRuntime JS
@inject TrabajoService Trabajo
@inject NavigationManager Navegacion

<PageTitle>Preparar pedido</PageTitle>

<div class="pedido-page">
    <header class="pedido-header">
        <div>
            <h1>Preparar pedido</h1>
            <p>@(Trabajo.Estado.Corte is not null && !Trabajo.Estado.PedidoAbierto
                ? "Anota lo que necesitas durante la semana. Puedes empezar sin cargar otro Excel."
                : "Revisa lo que tienes y agrega lo que necesitas de los centros seleccionados.")</p>
        </div>
        @if (Inventario.TieneInventario)
        {
            <span class="pedido-resumen">@Pedido.TotalProductos @(Pedido.TotalProductos == 1 ? "producto" : "productos") en tu pedido</span>
        }
    </header>

    @if (!Inventario.TieneInventario)
    {
        <div class="alert alert-info">Primero carga el Excel de inventario.</div>
        <a href="importar" class="btn btn-primary">Importar inventario</a>
    }
    else if (!Configuracion.EstaConfigurado)
    {
        <div class="alert alert-warning">Selecciona de qué bodegas vas a pedir.</div>
        <a href="importar" class="btn btn-primary">Elegir bodegas</a>
    }
    else if (Trabajo.Estado.Corte is not null && !Trabajo.Estado.PedidoAbierto)
    {
        <BorradorProximo />
        <p class="small text-muted mt-3">Tu pedido anterior está en el <a href="resumen">historial de pedidos</a>. Estas anotaciones son para el próximo envío.</p>
    }
    else
    {
        var productos = ObtenerFiltrados();
        int totalRecomendados = RecomendadosParaAgregar().Count;
        int totalPaginas = Math.Max(1, (int)Math.Ceiling(productos.Count / (double)TamanoPagina));
        pagina = Math.Clamp(pagina, 1, totalPaginas);
        var productosPagina = productos.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina).ToList();

        @if (Trabajo.Estado.Corte is CorteResumen corte)
        {
            <section class="inventory-context border rounded p-3 mb-3" aria-label="Reposición según el último inventario">
                <p class="small mb-2">Stock del último Excel: <strong>@corte.Archivo · @corte.Fecha.ToString("dd/MM/yyyy")</strong>.
                    @if (Trabajo.Estado.Cortes.Count > 1)
                    { <span>Comparado con @Trabajo.Estado.Cortes[1].Fecha.ToString("dd/MM/yyyy").</span> }
                </p>
                @if (Trabajo.Estado.Cortes.Count > 1)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button class="btn btn-primary btn-sm" disabled="@(generando || totalRecomendados == 0)" @onclick="GenerarBorrador">@(generando ? "Guardando…" : $"Generar borrador ({totalRecomendados})")</button>
                        <button class="btn btn-link btn-sm" @onclick="MostrarNuevos">Ver productos nuevos</button>
                    </div>
                    <p class="small text-muted mt-2 mb-0">Sugiere reposiciones de todas las marcas según las bajadas y la cobertura configurada. Conserva lo que ya agregaste. Una bajada puede ser venta, transferencia o ajuste.</p>
                }
                else
                { <p class="small text-muted mb-0">Este Excel es la base. Ya puedes pedir; el próximo Excel permitirá comparar existencias y recomendar reposiciones.</p> }
            </section>
        }
        <div class="pedido-ajustes">
            <ReporteMovimientos AlCambiar="ReporteActualizado" />
            <AjustesReposicion />
        </div>

        <nav class="pedido-vistas" aria-label="Listas del pedido">
            @if (Trabajo.Estado.Cortes.Count > 1)
            { <button class="btn @(vista == "Recomendados" ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(vista == "Recomendados")" @onclick="MostrarRecomendados">Recomendados (@totalRecomendados)</button> }
            <button class="btn @(vista == "Oportunidades" ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@(vista == "Oportunidades")" @onclick="MostrarOportunidades">Por revisar</button>
            <button class="btn @(vista == "Mi pedido" ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@(vista == "Mi pedido")" @onclick="MostrarMiPedido">Mi pedido (@Pedido.TotalProductos)</button>
            <button class="btn @(vista == "Nuevos" ? "btn-primary" : "btn-outline-secondary")" @onclick="MostrarNuevos">Nuevos (@nuevos.Count)</button>
            <details class="otras-listas" @key="vista">
                <summary>Otras listas</summary>
                <div class="otras-listas-menu">
                    <button class="btn btn-sm btn-light" @onclick="MostrarCatalogo">Todo el inventario</button>
                    <button class="btn btn-sm btn-light" @onclick="MostrarOmitidos">Omitidos por ahora (@Pedido.Omitidos.Count)</button>
                    <button class="btn btn-sm btn-light" @onclick="MostrarExcluidos">No se venden</button>
                    <button class="btn btn-sm btn-light" @onclick="MostrarDudosos">Sugerencias para revisar (@evaluaciones.Values.Count(p => !p.Rapido && p.Tipo != "Nuevo" && p.Cantidad > 0))</button>
                    @if (Actividad.TieneReporte)
                    { <button class="btn btn-sm btn-light" @onclick="MostrarSinMovimiento">Sin movimiento en tu sucursal</button> }
                </div>
            </details>
        </nav>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(esError ? "alert-danger" : "alert-success") py-2" role="status">@mensaje</div>
        }

        <section class="pedido-busqueda" aria-label="Buscar y filtrar productos">
            <div class="busqueda-principal">
                <div class="busqueda-texto">
                    <label for="buscarPedido">Buscar producto</label>
                    <input id="buscarPedido" type="search" class="form-control" placeholder="Nombre, código o referencia"
                           value="@busqueda" @oninput="CambiarBusqueda" />
                </div>
                <div class="busqueda-marca">
                    <label for="marcaPedido">Marca</label>
                    <SelectorBuscable Id="marcaPedido" Etiqueta="Marca" Valor="@marcaSeleccionada"
                        ValorChanged="v => CambiarMarca(new ChangeEventArgs { Value = v })"
                        Opciones="@marcas.Select(m => new OpcionSelector(m, m)).Prepend(new OpcionSelector("", "Todas las marcas"))" />
                </div>
                @if (vista is "Oportunidades" or "Recomendados")
                {
                    <label class="solo-agotados" for="soloAgotados">
                        <input id="soloAgotados" type="checkbox" class="form-check-input"
                               checked="@filtros.UsarMaximoB4" @onchange="CambiarSoloAgotados" />
                        Solo los que no tengo
                    </label>
                }
            </div>

            @if (vista is "Oportunidades" or "Recomendados" or "Sin movimiento")
            {
                @if (Actividad.Actual is ReporteActividad reporte)
                {
                    <div class="actividad-control">
                        <label class="actividad-toggle" for="apartarActividad">
                            <input id="apartarActividad" type="checkbox" class="form-check-input"
                                   checked="@filtros.ApartarSinMovimiento" @onchange="CambiarFiltroActividad" />
                            Apartar productos con stock y sin movimiento durante
                        </label>
                        <SelectorBuscable Etiqueta="Días sin movimiento" Clase="actividad-plazo" Valor="@filtros.DiasSinMovimiento.ToString()"
                            ValorChanged="v => CambiarDiasActividad(new ChangeEventArgs { Value = v })"
                            Opciones="@(new OpcionSelector[] { new("30", "30 días"), new("90", "90 días"), new("180", "180 días (aprox. 6 meses)"), new("365", "365 días (aprox. 1 año)") })" />
                        <button class="btn btn-link btn-sm" @onclick="MostrarSinMovimiento">Ver lista</button>
                        <small>Datos al @reporte.FechaReporte.ToString("dd/MM/yyyy"). Incluyen ventas y transferencias.
                            Los agotados, los productos sin información y tu pedido actual se conservan.
</small>
                    </div>
                }
            }

            <details class="opciones-avanzadas">
                <summary>Opciones avanzadas</summary>
                <div class="opciones-contenido">
                    <div class="opciones-grid">
                        <div>
                            <label for="grupoPedido">Grupo de productos</label>
                            <SelectorBuscable Id="grupoPedido" Etiqueta="Grupo de productos" Valor="@grupoSeleccionado"
                                ValorChanged="v => CambiarGrupo(new ChangeEventArgs { Value = v })"
                                Opciones="@grupos.Select(g => new OpcionSelector(g, g)).Prepend(new OpcionSelector("", "Todos los grupos"))" />
                        </div>
                        <div>
                            <label for="cantidadInicial">Empezar cada producto con</label>
                            <input id="cantidadInicial" type="number" min="0" step="any" class="form-control" @bind="opciones.CantidadInicial" />
                            <small>Para productos sin recomendación. Las reposiciones usan la cantidad sugerida, que puedes editar.</small>
                        </div>
                        <div>
                            <label for="reservaPedido">Dejar en cada bodega</label>
                            <input id="reservaPedido" type="number" min="0" step="any" class="form-control" @bind="opciones.ReservaCentro" />
                            <small>Si hay 100 y dejas 1, puedes pedir 99. Usa 0 para poder pedir todo.</small>
                        </div>
                        @if (vista is "Oportunidades" or "Recomendados")
                        {
                            <div>
                                <label for="minimoPedido">Mostrar si puedo pedir al menos</label>
                                <input id="minimoPedido" type="number" min="0" step="any" class="form-control" @bind="opciones.MinimoTransferible" />
                                <small>Con 10, solo verás productos con 10 o más disponibles en una misma bodega.</small>
                            </div>
                            <div>
                                <label for="ordenPedido">Mostrar primero</label>
                                <SelectorBuscable Id="ordenPedido" Etiqueta="Mostrar primero" @bind-Valor="opciones.Orden"
                                    Opciones="@(new OpcionSelector[] { new("local", "Los que menos tengo"), new("centro", "Los que más hay para pedir") })" />
                            </div>
                        }
                    </div>
                    <p class="small text-muted mt-3 mb-2">Estos ajustes no cambian las cantidades ni la reserva de productos que ya agregaste.</p>
                    <div class="opciones-acciones">
                        <button class="btn btn-primary btn-sm" @onclick="AplicarFiltros">Aplicar cambios</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="GuardarFiltros">Guardar para próximos pedidos</button>
                        <button class="btn btn-link btn-sm" @onclick="RestablecerFiltros">Restablecer</button>
                    </div>
                </div>
            </details>
            @if ((vista is "Oportunidades" or "Recomendados") && (filtros.UsarMaximoB4 || filtros.MinimoTransferible > 1))
            {
                <div class="limites-activos">
                    <span>Mostrando @(filtros.UsarMaximoB4 ? "solo productos sin stock en tu sucursal" : "productos disponibles")@((filtros.MinimoTransferible > 1) ? $" con al menos {Numero(filtros.MinimoTransferible)} para pedir" : "").</span>
                    <button class="btn btn-link btn-sm" @onclick="QuitarLimites">Ver todos los disponibles</button>
                </div>
            }
        </section>

        <div class="lista-toolbar">
            <div><h2>@TituloVista</h2><span class="text-muted small">@productos.Count productos</span></div>
            @if (vista == "Mi pedido")
            {
                <button class="btn btn-primary btn-sm" disabled="@(exportando || Pedido.TotalProductos == 0 || Pedido.Items.Any(i => i.RequiereRevision))" @onclick="ExportarPedido">
                    @(exportando ? "Preparando Excel…" : $"Descargar Excel ({Pedido.TotalProductos})")
                </button>
                <button class="btn btn-success btn-sm" disabled="@(cerrando || Pedido.TotalProductos == 0 || Pedido.Items.Any(i => i.RequiereRevision))" @onclick="CerrarPedido">@(cerrando ? "Guardando…" : "Guardar y cerrar pedido")</button>
                <a class="small" href="resumen">Historial</a>
            }
            @if (vista != "Mi pedido")
            {
                <div class="seleccion-acciones">
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(productosPagina.Count == 0)"
                            @onclick="() => SeleccionarPagina(productosPagina)">Marcar página</button>
                    @if (seleccionados.Count > 0)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="AgregarMarcados">Agregar marcados (@seleccionados.Count)</button>
                        <button class="btn btn-link btn-sm" @onclick="LimpiarSeleccion">Desmarcar</button>
                    }
                </div>
            }
        </div>
        <p class="lista-ayuda">@AyudaVista</p>
        <div class="filtros-columnas-resumen">
            <span>Pulsa el encabezado de una columna para filtrar u ordenar.</span>
            @foreach (var filtro in filtrosColumnas)
            {
                <button class="btn btn-sm filtro-etiqueta" @onclick="() => QuitarFiltroColumna(filtro.Key)"
                        title="Quitar este filtro">@NombreColumna(filtro.Key): @ResumenFiltro(filtro.Value) ×</button>
            }
            @if (columnaOrden is not null)
            { <span>Orden: @NombreColumna(columnaOrden) @(ordenDescendente ? "↓" : "↑")</span> }
            @if (filtrosColumnas.Count > 0 || columnaOrden is not null)
            { <button class="btn btn-link btn-sm" @onclick="LimpiarFiltrosColumnas">Limpiar filtros de columnas</button> }
        </div>

        <PopoverAnclado Id="filtro-pedido" Abierto="@(columnaAbierta is not null)" AnclaId="@($"columna-{columnaAbierta}")"
                        Titulo="@(columnaAbierta is null ? "Filtrar columna" : $"Filtrar {NombreColumna(columnaAbierta)}")" AlCerrar="CerrarFiltroColumna">
        @if (columnaAbierta is not null)
        {
            var valoresEncontrados = valoresColumna.Where(v => v.Texto.Contains(busquedaValores.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            <section class="filtro-columna-panel" aria-label="@($"Filtro de {NombreColumna(columnaAbierta)}")">
                <div class="filtro-panel-titulo"><strong>Filtrar: @NombreColumna(columnaAbierta)</strong>
                    <button class="btn btn-sm btn-light" @onclick="CerrarFiltroColumna" aria-label="Cerrar filtro sin aplicar">×</button></div>
                <p class="filtro-seccion">Ordenar productos</p>
                <div class="filtro-panel-orden">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => OrdenarColumna(false)">@(EsColumnaNumerica(columnaAbierta) ? "Menor a mayor ↑" : "A a Z ↑")</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => OrdenarColumna(true)">@(EsColumnaNumerica(columnaAbierta) ? "Mayor a menor ↓" : "Z a A ↓")</button>
                </div>
                <div class="filtro-panel-campos">
                    @if (EsColumnaNumerica(columnaAbierta))
                    {
                        <div class="selector-field"><label for="condicionColumna">Condición</label>
                            <SelectorBuscable Id="condicionColumna" Etiqueta="Condición" @bind-Valor="filtroEnEdicion.Condicion"
                                Opciones="@(new OpcionSelector[] { new("todos", "Todas las cantidades"), new("igual", "Igual a"), new("distinto", "Distinto de"), new("mayor", "Mayor que"), new("menor", "Menor que"), new("minimo", "Mayor o igual a"), new("maximo", "Menor o igual a"), new("entre", "Entre") })" />
                        </div>
                        @if (filtroEnEdicion.Condicion != "todos")
                        {
                            <label>@(filtroEnEdicion.Condicion == "entre" ? "Desde" : "Cantidad")
                                <input class="form-control form-control-sm" type="number" step="any" @bind="numeroDesde" @bind:event="oninput" /></label>
                            @if (filtroEnEdicion.Condicion == "entre")
                            { <label>Hasta<input class="form-control form-control-sm" type="number" step="any" @bind="numeroHasta" @bind:event="oninput" /></label> }
                        }
                    }
                    else
                    {
                        <label>Mostrar los que contienen<input class="form-control form-control-sm" placeholder="Escribe un código o texto…" @bind="filtroEnEdicion.Texto" @bind:event="oninput" /></label>
                    }
                </div>
                <details class="filtro-lista-valores" open="@(filtroEnEdicion.Valores is not null)">
                    <summary>Seleccionar valores concretos</summary>
                    <label class="visually-hidden" for="buscarValores">Buscar valores para marcar</label>
                    <input id="buscarValores" class="form-control form-control-sm" placeholder="Buscar en esta lista…" @bind="busquedaValores" @bind:event="oninput" @bind:after="ReiniciarListaValores" />
                    <div class="filtro-lista-acciones">
                        <button class="btn btn-link btn-sm" @onclick="() => SoloValores(valoresEncontrados)">Solo resultados</button>
                        <button class="btn btn-link btn-sm" @onclick="() => MarcarValores(valoresEncontrados, false)">Desmarcar</button>
                        <button class="btn btn-link btn-sm" @onclick="TodosLosValores">Restaurar todos</button>
                    </div>
                    <div class="filtro-valores">
                        @foreach (var valor in valoresEncontrados.Take(limiteValores))
                        {
                            <label @key="valor.Clave"><input type="checkbox" checked="@(filtroEnEdicion.Valores is null || filtroEnEdicion.Valores.Contains(valor.Clave))"
                                @onchange="e => MarcarValor(valor.Clave, e.Value is true)" /> <span>@valor.Texto</span></label>
                        }
                        @if (valoresEncontrados.Count == 0) { <p>No hay valores que coincidan.</p> }
                        @if (valoresEncontrados.Count > limiteValores)
                        { <button class="btn btn-link btn-sm" @onclick="() => limiteValores += 100">Mostrar más (@limiteValores de @valoresEncontrados.Count)</button> }
                    </div>
                </details>
                @if (errorFiltroColumna is not null) { <p class="text-danger small" role="alert">@errorFiltroColumna</p> }
                <div class="filtro-panel-acciones">
                    <button class="btn btn-primary btn-sm" @onclick="AplicarFiltroColumna">Aplicar filtro</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => QuitarFiltroColumna(columnaAbierta!)">Limpiar columna</button>
                </div>
            </section>
        }
        </PopoverAnclado>

        @if (vista == "Catálogo" && !TieneBusqueda() && !mostrarCatalogoCompleto)
        {
            <div class="alert alert-light border">Busca un producto o <button class="btn btn-link p-0" @onclick="MostrarTodoElCatalogo">muestra todo el inventario</button>.</div>
        }

        <div class="pedido-tabla-wrap" @key="(vista, pagina)" role="region" aria-label="Productos del pedido" tabindex="0">
            <table class="table pedido-tabla align-middle mb-0">
                <thead>
                    <tr>
                        @if (vista != "Mi pedido") { <th class="col-seleccion"><span class="visually-hidden">Marcar</span></th> }
                        @foreach (var columna in ColumnasVisibles)
                        {
                            <th class="@ClaseColumna(columna)" aria-sort="@(columnaOrden == columna ? (ordenDescendente ? "descending" : "ascending") : "none")">
                                <button id="@($"columna-{columna}")" class="encabezado-filtro @(filtrosColumnas.ContainsKey(columna) ? "filtrado" : "")"
                                        aria-haspopup="dialog" aria-controls="filtro-pedido"
                                        aria-label="@($"Filtrar y ordenar {NombreColumna(columna)}")" aria-expanded="@(columnaAbierta == columna ? "true" : "false")"
                                        @onclick="() => AbrirFiltroColumna(columna)">
                                    <span class="encabezado-texto">@NombreColumna(columna)</span><span class="encabezado-icono" aria-hidden="true">@if (columnaOrden == columna) { @(ordenDescendente ? "↓" : "↑") } else { <svg viewBox="0 0 16 16"><path d="M2 3h12L9 9v4l-2-1V9z" /></svg> }</span>
                                </button>
                            </th>
                        }
                        <th class="col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in productosPagina)
                    {
                        var item = Pedido.Obtener(producto.Codigo);
                        <tr @key="producto.Codigo" class="@(item?.RequiereRevision == true ? "pendiente-revision" : "")">
                            @if (vista != "Mi pedido")
                            {
                                <td><input type="checkbox" class="form-check-input" aria-label="@($"Marcar {producto.Descripcion}")"
                                    disabled="@(item is not null || ObtenerDisponibleCentro(producto) <= 0)"
                                    checked="@seleccionados.Contains(producto.Codigo)" @onchange="e => CambiarSeleccion(producto.Codigo, e)" /></td>
                            }
                            <td class="producto-info">
                                <div class="producto-principal">
                                <details class="producto-detalles">
                                    <summary title="Ver detalle del producto" aria-label="@($"Ver detalle de {producto.Codigo}")"><strong class="producto-codigo">@producto.Codigo</strong></summary>
                                    <div class="producto-descripcion-completa">@producto.Descripcion</div>
                                    <div>Marca: @producto.Marca</div>
                                    <div>Referencia: @producto.Referencia</div>
                                    <div>Unidad: @producto.UnidadMedida</div>
                                    <div>Nacional: @Numero(producto.TotalCalculado)</div>
                                    <div>Bame: @Numero(producto.ObtenerStock("B39")) — solo referencia</div>
                                    <div>Se dejan @Numero(item?.ReservaCentro ?? filtros.ReservaCentro) en cada bodega.</div>
                                    @if (evaluaciones.TryGetValue(producto.Codigo, out var evaluacion))
                                    { <div><strong>@evaluacion.Confianza:</strong> @evaluacion.Motivo</div> }
                                    @if (Actividad.Actual is ReporteActividad datos)
                                    {
                                        @if (Actividad.Obtener(producto.Codigo) is ActividadProducto dato)
                                        {
                                            <div>Sin actividad: @dato.DiasSinActividad días al @datos.FechaReporte.ToString("dd/MM/yyyy").</div>
                                            @if (dato.UltimoMovimiento is DateOnly ultimo)
                                            { <div>Último movimiento: @ultimo.ToString("dd/MM/yyyy")</div> }
                                            <div>Stock en el reporte local: @Numero(dato.StockB4)</div>
                                        }
                                        else { <div>Sin información de actividad: no se aparta automáticamente.</div> }
                                    }
                                </details>
                                <input class="form-control form-control-sm pedido-comentario" type="text" maxlength="300"
                                       placeholder="Comentario…" title="Comentario opcional para este pedido"
                                       aria-label="@($"Comentario para {producto.Codigo}")"
                                       value="@ComentarioPara(producto.Codigo)" @oninput="e => CambiarComentario(producto.Codigo, e)" />
                                </div>
                                <div class="producto-descripcion" title="@producto.Descripcion">@producto.Descripcion</div>
                                @if (vista != "Mi pedido" && recomendaciones.TryGetValue(producto.Codigo, out var propuesta))
                                { <div class="small" title="@propuesta.Motivo">Stock: @Numero(propuesta.StockAnterior ?? 0) → @Numero(propuesta.StockActual) · Reponer @Numero(CantidadParaAgregar(producto))</div> }
                                @if (vista == "Mi pedido" && item is not null)
                                {
                                    @if (item.RequiereRevision)
                                    { <div class="small fw-bold">Pendiente de revisar con este Excel: confirma origen y cantidad.</div> }
                                    <label class="small"><input type="checkbox" @bind="item.CompraExcepcional" @bind:after="Pedido.NotificarCambio" /> Compra excepcional (no aprender esta cantidad)</label>
