    private decimal ObtenerDisponibleCentro(
        ProductoInventario producto)
    {
        return ReglasAbastecimiento.MejorDisponible(producto, Configuracion.Actual, filtros.ReservaCentro);
    }

    private bool EsOportunidad(ProductoInventario producto)
    {
        return !Pedido.Contiene(producto.Codigo)
            && !Pedido.Omitidos.Contains(producto.Codigo)
            && !(filtros.ApartarSinMovimiento && Actividad.DebeApartar(producto, filtros.DiasSinMovimiento))
            && ReglasAbastecimiento.EsOportunidad(producto, Configuracion.Actual, filtros);
    }

    private bool TieneBusqueda()
    {
        return busqueda.Trim().Length >= 2 ||
               !string.IsNullOrWhiteSpace(marcaSeleccionada) ||
               !string.IsNullOrWhiteSpace(grupoSeleccionado) || filtrosColumnas.Count > 0 || columnaAbierta is not null || columnaOrden is not null;
    }

    private List<ProductoInventario> ObtenerFiltrados(string? excluirColumna = null)
    {
        if (vista == "Catálogo" &&
            !TieneBusqueda() &&
            !mostrarCatalogoCompleto)
        {
            return new List<ProductoInventario>();
        }

        IEnumerable<ProductoInventario> consulta =
            Inventario.Productos;

        if (vista == "Dudosos")
        {
            consulta = consulta.Where(p => evaluaciones.TryGetValue(p.Codigo, out var e) && !e.Rapido && e.Tipo != "Nuevo" && e.Cantidad > 0 && !Pedido.Contiene(p.Codigo));
        }
        else if (vista == "Oportunidades")
        {
            consulta = consulta.Where(EsOportunidad);
        }
        else if (vista == "Nuevos")
        {
            consulta = consulta.Where(p => nuevos.Contains(p.Codigo) && !Pedido.Contiene(p.Codigo));
        }
        else if (vista == "Recomendados")
        {
            consulta = consulta.Where(p => recomendaciones.ContainsKey(p.Codigo) && EsOportunidad(p));
        }
        else if (vista == "Mi pedido")
        {
            var catalogo = Inventario.Productos.ToDictionary(p => p.Codigo, StringComparer.OrdinalIgnoreCase);
            consulta = Pedido.Items.Select(i => catalogo.GetValueOrDefault(i.CodigoProducto)
                ?? new ProductoInventario { Codigo = i.CodigoProducto, Descripcion = i.DescripcionProducto + " (ausente del corte actual)" });
        }
        else if (vista == "Omitidos")
        {
            consulta = consulta.Where(p => Pedido.Omitidos.Contains(p.Codigo));
        }
        else if (vista == "No sugerir")
        {
            consulta = consulta.Where(p => Configuracion.Actual.ProductosNoSugerir.Contains(p.Codigo));
        }
        else if (vista == "Sin movimiento")
        {
            consulta = consulta.Where(p => Actividad.DebeApartar(p, filtros.DiasSinMovimiento));
        }

        if (!string.IsNullOrWhiteSpace(busqueda))
        {
            string texto = busqueda.Trim();

            consulta = consulta.Where(p =>
                p.Codigo.Contains(
                    texto, StringComparison.OrdinalIgnoreCase) ||
                p.Descripcion.Contains(
                    texto, StringComparison.OrdinalIgnoreCase) ||
                p.Referencia.Contains(
                    texto, StringComparison.OrdinalIgnoreCase) ||
                p.Marca.Contains(
                    texto, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(marcaSeleccionada))
        {
            consulta = consulta.Where(p =>
                string.Equals(
                    p.Marca,
                    marcaSeleccionada,
                    StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(grupoSeleccionado))
        {
            consulta = consulta.Where(p =>
                string.Equals(
                    p.Grupo,
                    grupoSeleccionado,
                    StringComparison.OrdinalIgnoreCase));
        }

        foreach (var filtro in filtrosColumnas.Where(f => f.Key != excluirColumna && ColumnasVisibles.Contains(f.Key)))
            consulta = consulta.Where(p => filtro.Value.Coincide(ValorColumna(p, filtro.Key)));

        if (columnaOrden is not null && ColumnasVisibles.Contains(columnaOrden))
        {
            consulta = EsColumnaNumerica(columnaOrden)
                ? (ordenDescendente ? consulta.OrderByDescending(p => ValorColumna(p, columnaOrden).Numero) : consulta.OrderBy(p => ValorColumna(p, columnaOrden).Numero)).ThenBy(p => p.Codigo)
                : (ordenDescendente ? consulta.OrderByDescending(p => ValorColumna(p, columnaOrden).Texto, StringComparer.OrdinalIgnoreCase) : consulta.OrderBy(p => ValorColumna(p, columnaOrden).Texto, StringComparer.OrdinalIgnoreCase)).ThenBy(p => p.Codigo);
        }
        else if (vista == "Recomendados")
        {
            consulta = consulta.OrderByDescending(p => recomendaciones[p.Codigo].Prioridad).ThenBy(p => p.Codigo);
        }
        else if (vista == "Oportunidades")
        {
            consulta = filtros.Orden switch
            {
                "centro" => consulta
                    .OrderByDescending(ObtenerDisponibleCentro)
                    .ThenBy(p => p.Descripcion),

                _ => consulta
                    .OrderBy(p => p.ObtenerStock(Configuracion.Actual.BodegaLocal))
                    .ThenByDescending(ObtenerDisponibleCentro)
                    .ThenBy(p => p.Codigo)
            };
        }
        else
        {
            consulta = consulta
                .OrderBy(p => p.Marca)
                .ThenBy(p => p.Descripcion);
        }

        return consulta.ToList();
    }

    private IEnumerable<string> BodegasConStock(
        ProductoInventario producto)
    {
        decimal reserva = Pedido.Obtener(producto.Codigo)?.ReservaCentro ?? filtros.ReservaCentro;
        return Configuracion.Actual.OrigenesHabilitados
            .Where(b => ReglasAbastecimiento.Disponible(producto, b, reserva) > 0)
            .OrderByDescending(b => producto.ObtenerStock(b));
    }

    private async Task GuardarFiltros()
    {
        if (!ValidarFiltros(opciones))
            return;

        AplicarFiltros();

        try
        {
            string json = JsonSerializer.Serialize(filtros);

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                ClaveFiltros,
                json);

            esError = false;
            mensaje = "Opciones guardadas para tus próximos pedidos.";
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = ex.Message;
        }
    }

    private bool ValidarFiltros(FiltrosPedido? valores = null)
    {
        var actuales = valores ?? filtros;
        if (actuales.ReservaCentro < 0 ||
            actuales.MinimoTransferible <= 0 ||
            actuales.CantidadInicial <= 0 ||
            actuales.StockMaximoB4 < 0 ||
            !new[] { 30, 90, 180, 365 }.Contains(actuales.DiasSinMovimiento))
        {
            esError = true;
            mensaje = "La cantidad inicial y el mínimo deben ser mayores que cero; la reserva no puede ser negativa. El plazo sin movimiento debe ser 30, 90, 180 o 365 días.";
            return false;
        }

        return true;
    }

    private void AplicarFiltros()
    {
        if (!ValidarFiltros(opciones))
            return;

        filtros = opciones.Copiar();

        pagina = 1;
        seleccionados.Clear();
        esError = false;
        mensaje = "Opciones aplicadas. Los productos que ya agregaste conservan sus cantidades.";
    }

    private void RestablecerFiltros()
    {
        filtros = new FiltrosPedido();
        opciones = filtros.Copiar();
        pagina = 1;
        seleccionados.Clear();

        mensaje = "Se restablecieron las opciones iniciales.";
        esError = false;
    }

    private void CambiarSoloAgotados(ChangeEventArgs e)
    {
        filtros.UsarMaximoB4 = e.Value is true;
        filtros.StockMaximoB4 = 0;
        opciones.UsarMaximoB4 = filtros.UsarMaximoB4;
        opciones.StockMaximoB4 = 0;
        pagina = 1;
        seleccionados.Clear();
        mensaje = null;
    }

    private void QuitarLimites()
    {
        filtros.UsarMaximoB4 = false;
        filtros.MinimoTransferible = 1;
        opciones.UsarMaximoB4 = false;
        opciones.MinimoTransferible = 1;
        pagina = 1;
        seleccionados.Clear();
        mensaje = null;
    }

    private void CambiarSeleccion(
        string codigo,
        ChangeEventArgs e)
    {
        bool marcado = e.Value is bool valor && valor;

        if (marcado)
            seleccionados.Add(codigo);
        else
            seleccionados.Remove(codigo);
    }

    private void SeleccionarPagina(
        IEnumerable<ProductoInventario> productos)
    {
        foreach (var producto in productos)
        {
            if (!Pedido.Contiene(producto.Codigo) && ObtenerDisponibleCentro(producto) > 0)
                seleccionados.Add(producto.Codigo);
        }
    }

    private void LimpiarSeleccion()
    {
        seleccionados.Clear();
    }

    private void AgregarUno(ProductoInventario producto)
    {
        if (!ValidarFiltros())
            return;

        bool agregado = AgregarPreparado(producto);

        if (agregado)
        {
            Actividad.Incluir(producto.Codigo);
            Pedido.Omitidos.Remove(producto.Codigo);
            seleccionados.Remove(producto.Codigo);
        }

        esError = !agregado;

        mensaje = agregado
            ? $"{producto.Codigo} agregado con {Pedido.Obtener(producto.Codigo)!.CantidadSolicitada} unidades. Puedes ajustar la cantidad en Mi pedido."
            : "No existe suficiente stock en un centro seleccionado.";
    }

    private void AgregarMarcados()
    {
        if (!ValidarFiltros())
            return;

        // Solo operamos sobre los resultados del filtro actual.
        var productos = ObtenerFiltrados()
            .Where(p => seleccionados.Contains(p.Codigo) && !Pedido.Contiene(p.Codigo))
            .ToList();

        int agregados = 0;
        foreach (var producto in productos)
        {
            if (AgregarPreparado(producto))
                agregados++;
        }

        foreach (var producto in productos.Where(p => Pedido.Contiene(p.Codigo)))
        {
            Pedido.Omitidos.Remove(producto.Codigo);
            Actividad.Incluir(producto.Codigo);
        }

        seleccionados.Clear();

        esError = false;
        mensaje = $"{agregados} productos añadidos al pedido. {productos.Count - agregados} no se pudieron agregar. Ajusta las cantidades en Mi pedido.";
    }

    private async Task ExcluirUno(ProductoInventario producto)
    {
        await ExcluirProductos(new[] { producto.Codigo });
    }

    private async Task ExcluirProductos(
        IEnumerable<string> codigos)
    {
        var lista = codigos.ToList();
        var anteriores = new HashSet<string>(Configuracion.Actual.ProductosNoSugerir,
            StringComparer.OrdinalIgnoreCase);

        foreach (string codigo in lista)
        {
            Configuracion.Actual.ProductosNoSugerir.Add(codigo);
        }

        try
        {
            await Configuracion.GuardarAsync();

            foreach (var codigo in lista)
                Pedido.Omitidos.Remove(codigo);

            seleccionados.Clear();
            pagina = 1;

            esError = false;
            mensaje = "Producto apartado porque no se vende. Puedes recuperarlo en Otras listas → No se venden.";
        }
        catch (Exception ex)
        {
            Configuracion.Actual.ProductosNoSugerir = anteriores;
            esError = true;
            mensaje = ex.Message;
        }
    }

    private async Task Reactivar(ProductoInventario producto)
    {
        bool estabaExcluido = Configuracion.Actual.ProductosNoSugerir.Remove(
            producto.Codigo);

        try
        {
            await Configuracion.GuardarAsync();

            esError = false;
            mensaje = "Producto habilitado para sugerencias.";
        }
        catch (Exception ex)
        {
            if (estabaExcluido)
                Configuracion.Actual.ProductosNoSugerir.Add(producto.Codigo);
            esError = true;
            mensaje = ex.Message;
        }
    }

    private void Quitar(string codigo)
    {
        Pedido.Quitar(codigo);
        seleccionados.Remove(codigo);
        mensaje = null;
    }

    private void CambiarCantidad(
        ProductoInventario producto,
        ChangeEventArgs e)
    {
        revisionCantidades++;
        string texto = e.Value?.ToString() ?? "";

        if (!decimal.TryParse(
            texto,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out decimal cantidad) ||
            !Pedido.CambiarCantidad(producto, cantidad))
        {
            esError = true;
            mensaje = "Cantidad inválida o superior al stock " +
                      "disponible después de dejar la reserva del centro.";
            return;
        }

        mensaje = null;
    }

    private decimal CantidadParaAgregar(ProductoInventario producto) =>
        Math.Min(cantidadesPreparadas.GetValueOrDefault(producto.Codigo, recomendaciones.TryGetValue(producto.Codigo, out var propuesta) ? propuesta.Cantidad : filtros.CantidadInicial),
            ObtenerDisponibleCentro(producto));

    private string ComentarioPara(string codigo) =>
        Pedido.Obtener(codigo)?.Comentario ?? comentariosPreparados.GetValueOrDefault(codigo, "");

    private void CambiarComentario(string codigo, ChangeEventArgs e)
    {
        string comentario = e.Value?.ToString() ?? "";
        if (comentario.Length > 300) comentario = comentario[..300];
        if (Pedido.Obtener(codigo) is { } item)
        {
            item.Comentario = comentario;
            Pedido.NotificarCambio();
        }
        else if (comentario.Length == 0) comentariosPreparados.Remove(codigo);
        else comentariosPreparados[codigo] = comentario;
    }

    private bool AgregarPreparado(ProductoInventario producto)
    {
        if (!Pedido.Agregar(producto, Configuracion.Actual, CantidadParaAgregar(producto),
                filtros.ReservaCentro, ComentarioPara(producto.Codigo))) return false;
        comentariosPreparados.Remove(producto.Codigo);
        return true;
    }

    private void PrepararCantidad(ProductoInventario producto, ChangeEventArgs e)
    {
        revisionCantidades++;
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture,
                out decimal cantidad) || cantidad <= 0 || cantidad > ObtenerDisponibleCentro(producto))
        {
            esError = true;
            mensaje = "Escribe una cantidad mayor que cero y dentro de la disponibilidad de un centro. No se guardó el cambio.";
            return;
        }
        cantidadesPreparadas[producto.Codigo] = cantidad;
        mensaje = null;
    }

    private void CambiarBodega(
        ProductoInventario producto,
        ChangeEventArgs e)
    {
        string codigo = e.Value?.ToString() ?? "";
        decimal anterior = Pedido.Obtener(producto.Codigo)?.CantidadSolicitada ?? 0;

        if (!Pedido.CambiarBodega(
            producto,
            codigo,
            Configuracion.Actual))
        {
            esError = true;
            mensaje = "No hay stock en la bodega seleccionada.";
            return;
        }

        esError = false;
        decimal actual = Pedido.Obtener(producto.Codigo)?.CantidadSolicitada ?? 0;
        mensaje = actual < anterior
            ? $"La cantidad se ajustó de {anterior} a {actual} por la disponibilidad del nuevo centro."
            : null;
    }

