    private static bool EsColumnaNumerica(string columna) => columna is "local" or "pedir" || ConfiguracionBodegas.EsCodigoValido(columna);
    private string NombreColumna(string columna) => columna switch
    { "producto" => "Código / descripción", "local" => "Tengo", "origen" => "Pedir a", "pedir" => "Pedir", _ => Configuracion.ObtenerNombreBodega(columna) };
    private static string ClaseColumna(string columna) => columna switch
    { "producto" => "col-producto", "origen" => "col-origen", "pedir" => "col-cantidad", _ => "col-stock" };

    private ValorColumnaPedido ValorColumna(ProductoInventario producto, string columna)
    {
        var item = Pedido.Obtener(producto.Codigo);
        if (columna == "producto") return new(producto.Codigo, $"{producto.Codigo} · {producto.Descripcion}");
        if (columna == "origen") return new(item?.BodegaOrigen ?? "", item is null ? "Sin origen" : Configuracion.ObtenerNombreBodega(item.BodegaOrigen));
        if (ConfiguracionBodegas.EsCodigoValido(columna) && !Configuracion.Actual.OrigenesHabilitados.Contains(columna)) return new("", "— (bodega desactivada)");
        decimal numero = columna switch
        {
            "local" => producto.ObtenerStock(Configuracion.Actual.BodegaLocal),
            "pedir" => item?.CantidadSolicitada ?? CantidadParaAgregar(producto),
            _ => ReglasAbastecimiento.Disponible(producto, columna, item?.ReservaCentro ?? filtros.ReservaCentro)
        };
        return new(numero.ToString("G29", CultureInfo.InvariantCulture), Numero(numero), numero);
    }

    private void AbrirFiltroColumna(string columna)
    {
        if (columnaAbierta == columna) { CerrarFiltroColumna(); return; }
        columnaAbierta = columna;
        filtroEnEdicion = filtrosColumnas.TryGetValue(columna, out var activo) ? activo.Copiar() : new();
        numeroDesde = filtroEnEdicion.Desde?.ToString(CultureInfo.InvariantCulture) ?? "";
        numeroHasta = filtroEnEdicion.Hasta?.ToString(CultureInfo.InvariantCulture) ?? "";
        busquedaValores = "";
        errorFiltroColumna = null;
        limiteValores = 100;
        valoresColumna = ObtenerFiltrados(columna).Select(p => ValorColumna(p, columna))
            .DistinctBy(v => v.Clave, StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v.Numero).ThenBy(v => v.Texto, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void CerrarFiltroColumna() { columnaAbierta = null; errorFiltroColumna = null; }
    private void ReiniciarListaValores() => limiteValores = 100;
    private void TodosLosValores() => filtroEnEdicion.Valores = null;
    private void SoloValores(IEnumerable<ValorColumnaPedido> valores) => filtroEnEdicion.Valores = valores.Select(v => v.Clave).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private void MarcarValor(string clave, bool marcado)
    {
        filtroEnEdicion.Valores ??= valoresColumna.Select(v => v.Clave).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (marcado) filtroEnEdicion.Valores.Add(clave); else filtroEnEdicion.Valores.Remove(clave);
    }
    private void MarcarValores(IEnumerable<ValorColumnaPedido> valores, bool marcado)
    { foreach (var valor in valores) MarcarValor(valor.Clave, marcado); }
    private void ReiniciarPaginaColumnas() { pagina = 1; seleccionados.Clear(); mensaje = null; }
    private void OrdenarColumna(bool descendente)
    {
        columnaOrden = columnaAbierta;
        ordenDescendente = descendente;
        CerrarFiltroColumna();
        ReiniciarPaginaColumnas();
    }
    private void AplicarFiltroColumna()
    {
        if (columnaAbierta is null) return;
        if (filtroEnEdicion.Condicion != "todos")
        {
            const NumberStyles estilo = NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint;
            if (!decimal.TryParse(numeroDesde.Replace(',', '.'), estilo, CultureInfo.InvariantCulture, out var desde))
            { errorFiltroColumna = "Escribe una cantidad válida."; return; }
            filtroEnEdicion.Desde = desde;
            if (filtroEnEdicion.Condicion == "entre")
            {
                if (!decimal.TryParse(numeroHasta.Replace(',', '.'), estilo, CultureInfo.InvariantCulture, out var hasta) || hasta < desde)
                { errorFiltroColumna = "El valor Hasta debe ser igual o mayor que Desde."; return; }
                filtroEnEdicion.Hasta = hasta;
            }
        }
        if (filtroEnEdicion.Activo) filtrosColumnas[columnaAbierta] = filtroEnEdicion.Copiar();
        else filtrosColumnas.Remove(columnaAbierta);
        CerrarFiltroColumna();
        ReiniciarPaginaColumnas();
    }
    private void QuitarFiltroColumna(string columna)
    {
        filtrosColumnas.Remove(columna);
        CerrarFiltroColumna();
        ReiniciarPaginaColumnas();
    }
    private void LimpiarFiltrosColumnas()
    {
        filtrosColumnas.Clear();
        columnaOrden = null;
        CerrarFiltroColumna();
        ReiniciarPaginaColumnas();
    }
    private static string ResumenFiltro(FiltroColumnaPedido filtro)
    {
        var partes = new List<string>();
        if (!string.IsNullOrWhiteSpace(filtro.Texto)) partes.Add($"contiene «{filtro.Texto.Trim()}»");
        if (filtro.Condicion != "todos")
        {
            var operador = filtro.Condicion switch { "igual" => "=", "distinto" => "≠", "mayor" => ">", "menor" => "<", "minimo" => "≥", "maximo" => "≤", _ => "entre" };
            partes.Add($"{operador} {Numero(filtro.Desde ?? 0)}" + (filtro.Condicion == "entre" ? $" y {Numero(filtro.Hasta ?? 0)}" : ""));
        }
        if (filtro.Valores is not null) partes.Add($"{filtro.Valores.Count} valores marcados");
        return string.Join(" · ", partes);
    }

    private static string Numero(decimal valor) => valor.ToString("0.############################", CultureInfo.CurrentCulture);

    private string TituloVista => vista switch
