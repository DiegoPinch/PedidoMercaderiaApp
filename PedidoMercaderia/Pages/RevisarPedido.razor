    private async Task CerrarPedido()
    {
        if (cerrando) return;
        cerrando = true; mensaje = null;
        try { await Trabajo.Realizar(); Navegacion.NavigateTo("resumen"); }
        catch (Exception ex) { esError = true; mensaje = ex.Message; }
        finally { cerrando = false; }
    }

    private void MostrarRecomendados()
    {
        MostrarMiPedido();
        vista = "Recomendados";
    }

    private async Task GenerarBorrador()
    {
        if (generando || !ValidarFiltros()) return;
        generando = true; mensaje = null;
        try
        {
            int agregados = 0;
            foreach (var producto in RecomendadosParaAgregar())
                if (AgregarPreparado(producto)) agregados++;
            if (Pedido.EsperarGuardado is not null) await Pedido.EsperarGuardado();
            MostrarMiPedido();
            esError = false;
            mensaje = $"{agregados} reposiciones añadidas. Revisa cantidades y descarga tu Excel cuando esté listo.";
        }
        catch (Exception ex) { esError = true; mensaje = ex.Message; }
        finally { generando = false; }
    }

