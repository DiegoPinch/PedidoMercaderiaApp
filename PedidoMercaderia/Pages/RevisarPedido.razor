    private Dictionary<string, PropuestaPedido> recomendaciones = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, PropuestaPedido> evaluaciones = new(StringComparer.OrdinalIgnoreCase);

    private async Task ExportarPedido()
    {
        if (exportando) return;
        exportando = true;
        mensaje = null;
        try
        {
            using var archivo = new MemoryStream(await Trabajo.DescargarExcel());
            using var referencia = new DotNetStreamReference(archivo);
            await using var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/descargarPedido.js");
            await modulo.InvokeVoidAsync("descargarPedido", $"Pedido_{DateTime.Now:yyyy-MM-dd_HHmm}.xlsx", referencia);
            mensaje = "Descarga iniciada. Adjunta el Excel a tu correo cuando termine de descargarse.";
            esError = false;
        }
        catch (InvalidOperationException ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        catch (Exception)
        {
            mensaje = "No se pudo descargar el Excel. Tu pedido sigue aquí; intenta descargarlo de nuevo.";
            esError = true;
        }
        finally { exportando = false; }
    }
    private string busqueda = "";
    private string marcaSeleccionada = "";
    private string grupoSeleccionado = "";

    private string? mensaje;
    private bool esError;

    private int pagina = 1;
    private bool mostrarCatalogoCompleto;

    private List<string> marcas = new();
    private List<string> grupos = new();

    private HashSet<string> seleccionados =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly Dictionary<string, decimal> cantidadesPreparadas = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> comentariosPreparados = new(StringComparer.OrdinalIgnoreCase);
    private int revisionCantidades;

    protected override async Task OnInitializedAsync()
    {
        nuevos = Trabajo.Estado.Cambios.Where(c => c.Tipo == "Nuevo").Select(c => c.Codigo).ToHashSet(StringComparer.OrdinalIgnoreCase);
        recomendaciones = Trabajo.Estado.Propuestas.Where(p => p.Rapido).ToDictionary(p => p.Codigo, StringComparer.OrdinalIgnoreCase);
        evaluaciones = Trabajo.Estado.Propuestas.ToDictionary(p => p.Codigo, StringComparer.OrdinalIgnoreCase);
        if (Trabajo.Estado.Cortes.Count > 1 && ListaInicial != "mi-pedido") vista = "Recomendados";
        if (Pedido.Items.Any(i => i.RequiereRevision)) vista = "Mi pedido";

        try
        {
            string? json = await JS.InvokeAsync<string?>(
                "localStorage.getItem", ClaveFiltros);

            if (!string.IsNullOrWhiteSpace(json))
            {
                filtros = JsonSerializer.Deserialize<FiltrosPedido>(json)
                    ?? new FiltrosPedido();
            }
            else
            {
                string? anteriores = await JS.InvokeAsync<string?>(
                    "localStorage.getItem", "PedidoMercaderia.Filtros.v3");
                if (string.IsNullOrWhiteSpace(anteriores))
                    anteriores = await JS.InvokeAsync<string?>("localStorage.getItem", "PedidoMercaderia.Filtros.v2");
                if (!string.IsNullOrWhiteSpace(anteriores))
                {
                    var anterioresFiltros = JsonSerializer.Deserialize<FiltrosPedido>(anteriores);
