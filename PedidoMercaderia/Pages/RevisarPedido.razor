    private void CambiarFiltroActividad(ChangeEventArgs e)
    {
        filtros.ApartarSinMovimiento = e.Value is true;
        opciones.ApartarSinMovimiento = filtros.ApartarSinMovimiento;
        pagina = 1;
        seleccionados.Clear();
        mensaje = null;
    }

    private void CambiarDiasActividad(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int dias) && new[] { 30, 90, 180, 365 }.Contains(dias))
        {
            filtros.DiasSinMovimiento = dias;
            opciones.DiasSinMovimiento = dias;
            pagina = 1;
            seleccionados.Clear();
            mensaje = null;
        }
    }

    private void RecuperarActividad(string codigo)
    {
        Actividad.Incluir(codigo);
        seleccionados.Remove(codigo);
        esError = false;
        mensaje = "Incluido para esta revisión. Aparecerá en Por revisar si cumple los demás filtros y no está en No se venden.";
    }

    private void Omitir(string codigo)
    {
        Pedido.Omitidos.Add(codigo);
        seleccionados.Remove(codigo);
        mensaje = null;
    }

    private void RecuperarOmitido(string codigo)
    {
        Pedido.Omitidos.Remove(codigo);
        seleccionados.Remove(codigo);
    }

    private void PaginaAnterior()
    {
        pagina = Math.Max(1, pagina - 1);
    }

    private void PaginaSiguiente()
    {
        pagina++;
    }
}

