@page "/"
@page "/importar"
@page "/configuracion"
@using Microsoft.AspNetCore.Components.Forms
@using PedidoMercaderia.Models
@using PedidoMercaderia.Services
@using PedidoMercaderia.Components
@inject InventarioService Inventario
@inject ConfiguracionService Configuracion
@inject TrabajoService Trabajo

<PageTitle>Inventario</PageTitle>
<div class="module-page inventario-page">
    <header class="module-header">
    <div><span class="module-eyebrow">EXISTENCIAS</span>
    <h1 class="h3">@(Trabajo.Estado.Inventario is null ? "Carga tu inventario" : "Inventario")</h1>
    @if (Trabajo.Estado.Inventario is null)
    { <p class="text-muted">Sube el Excel del sistema para comenzar.</p> }
    else { <p>Consulta tus productos y mantén sus existencias al día.</p> }
    </div>
    @if (Trabajo.Estado.Inventario is { } actual) { <span class="module-badge">@actual.TotalProductos.ToString("N0") productos</span> }
    </header>
    <section class="ui-card inventory-upload" aria-label="Cargar Excel">
        @if (Trabajo.Estado.PedidoAbierto)
        {
            <div class="inventory-open">
            <div class="ui-notice"><strong>Tu pedido está en preparación</strong><p class="small mb-0">Guárdalo y ciérralo antes de cargar otro Excel.</p></div>
            <a class="btn btn-primary btn-sm mb-2" href="pedido?lista=mi-pedido">Continuar pedido</a>
            </div>
            <details><summary class="small">Anular esta preparación</summary>
                <p class="small mt-2">El borrador se conservará para revisar con el siguiente Excel.</p>
                <button class="btn btn-outline-danger btn-sm" disabled="@procesando" @onclick="AnularPreparacion">Anular y permitir otro Excel</button>
            </details>
        }
        @if (!Trabajo.Estado.PedidoAbierto)
        {
        <fieldset class="mt-3" disabled="@(procesando || Trabajo.Estado.PedidoAbierto)">
            <div class="row g-3 align-items-end">
                <div class="col-sm-4"><label class="form-label" for="fechaInventario">Fecha del inventario</label>
                    <input id="fechaInventario" type="date" class="form-control" @bind="fechaInventario" max="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                <div class="col-sm-8"><label class="form-label" for="archivoInventario">@(Trabajo.Estado.Inventario is null ? "Archivo Excel" : "Actualizar con otro Excel")</label>
                    <InputFile id="archivoInventario" class="form-control" accept=".xls,.xlsx" OnChange="ImportarArchivo" /></div>
            </div>
            <small class="text-muted">.xls o .xlsx · Hasta 20 MB</small>
        </fieldset>
        }
        @if (procesando) { <p class="mt-2 mb-0" role="status">Guardando inventario…</p> }
        @if (error is not null) { <div class="alert alert-danger mt-2" role="alert">@error</div> }
    </section>
    @if (Trabajo.Estado.Inventario is ResultadoImportacion resultado)
    {
        <p class="small text-muted">@resultado.NombreArchivo · @resultado.TotalProductos productos · @resultado.BodegasDetectadas.Count bodegas
            @if (Configuracion.EstaConfigurado) { <span> · @Configuracion.ObtenerEtiquetaBodega(Configuracion.Actual.BodegaLocal)</span> }
        </p>
        @if (Configuracion.EstaConfigurado)
        {
            @if (!Trabajo.Estado.PedidoAbierto)
            {
            <div class="d-flex flex-wrap align-items-center gap-3 my-3">
                <a class="btn btn-primary" href="pedido">Preparar pedido</a>
            </div>
            }
            <details class="border rounded p-3 mb-3"><summary>Cambiar sucursal, centros o nombres</summary><div class="mt-3"><AjustesBodegas /></div></details>
        }
        else if (Trabajo.Usuario?.Rol == "Administrador")
        { <section class="border rounded p-3 mb-3"><AjustesBodegas /></section> }
        else { <p>El administrador debe elegir la sucursal y los centros para empezar.</p> }
        <TablaInventario Inventario="resultado" />
        @if (resultado.FilasOmitidas > 0 || resultado.Advertencias.Count > 0 || resultado.DiferenciasTotales > 0)
        {
            <details class="border rounded p-3"><summary>Observaciones del archivo</summary>
                <p class="small mt-2">@resultado.FilasOmitidas filas omitidas · @resultado.DiferenciasTotales diferencias de totales</p>
                @foreach (var aviso in resultado.Advertencias) { <p class="small">@aviso</p> }
            </details>
        }
    }
</div>
@code {
    private const long LimiteArchivo = 20L * 1024 * 1024;

    private bool procesando;
    private DateTime fechaInventario = DateTime.Today;
    private string? error;


    private async Task AnularPreparacion()
    {
        procesando = true; error = null;
        try { await Trabajo.AnularPreparacion(); }
        catch (Exception ex) { error = ex.Message; }
        finally { procesando = false; }
    }

    private async Task ImportarArchivo(InputFileChangeEventArgs e)
    {
        error = null;

        var archivo = e.File;

        bool formatoValido =
            archivo.Name.EndsWith(
                ".xls", StringComparison.OrdinalIgnoreCase)
            ||
            archivo.Name.EndsWith(
                ".xlsx", StringComparison.OrdinalIgnoreCase);

        if (!formatoValido)
        {
            error = "Selecciona un archivo .xls o .xlsx.";
            return;
        }

        if (archivo.Size == 0 || archivo.Size > LimiteArchivo)
        {
            error = "El archivo está vacío o supera los 20 MB.";
            return;
        }

        procesando = true;


        StateHasChanged();


        try
        {
            await Task.Yield();

            await using var flujo = archivo.OpenReadStream(
                maxAllowedSize: LimiteArchivo);

            using var memoria = new MemoryStream();

            await flujo.CopyToAsync(memoria);
            memoria.Position = 0;


            var nuevoInventario = Inventario.Analizar(memoria, archivo.Name);
            await Trabajo.Importar(nuevoInventario, DateOnly.FromDateTime(fechaInventario));


        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {


            procesando = false;
        }
    }
}
