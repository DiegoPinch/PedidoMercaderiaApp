    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <Compile Include="../../PedidoMercaderia/Service/PedidoExportacionService.cs" Link="PedidoExportacionService.cs" />
    <Compile Include="../../PedidoMercaderia/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
