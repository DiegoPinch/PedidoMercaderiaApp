    <Compile Include="../../PedidoMercaderia/Service/PedidoService.cs" Link="PedidoService.cs" />
    <Compile Include="../../PedidoMercaderia/Service/ConfiguracionService.cs" Link="ConfiguracionService.cs" />
    <Compile Include="../../PedidoMercaderia/Service/ActividadService.cs" Link="ActividadService.cs" />
    <Compile Include="../../PedidoMercaderia/Service/ExcelImportacionService.cs" Link="ExcelImportacionService.cs" />
    <Compile Include="../../PedidoMercaderia/Service/InventarioService.cs" Link="InventarioService.cs" />
    <RazorComponent Include="../../PedidoMercaderia/Pages/RevisarPedido.razor" Link="Components/RevisarPedido.razor" />
  </ItemGroup>
</Project>
